# Copy to .env or pass directly to docker compose.
POSTGRES_USER=fab
POSTGRES_PASSWORD=fabpass
POSTGRES_DB=fab
# Leave SHUTDOWN_TOKEN unset in production to disable /internal/shutdown.
# SHUTDOWN_TOKEN=change-me
# Revision simulation refuses (never truncates) when more than this many
# decided batches follow the target batch.  Defaults to 50.
# REVISION_MAX_FOLLOWUP_BATCHES=50
